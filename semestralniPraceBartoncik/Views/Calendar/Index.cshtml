@{
	ViewData["Title"] = "Kalendáø technikù";
	var technicians = ViewBag.Technicians as IEnumerable<User> ?? Enumerable.Empty<User>();
	var selectedTechnicianId = ViewBag.SelectedTechnicianId as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1>Kalendáø technikù</h1>
	<div>
		<a href="/Orders/Create" class="btn btn-primary">Nová zakázka</a>
	</div>
</div>

<div class="card mb-4">
	<div class="card-body">
		<div class="row align-items-end">
			<div class="col-md-4">
				<label class="form-label">Filtrovat podle technika</label>
				<select id="technicianFilter" class="form-select">
					<option value="">-- Všichni technici --</option>
					@foreach (var tech in technicians)
					{
						<option value="@tech.Id" selected="@(tech.Id == selectedTechnicianId)">
							@tech.Name
						</option>
					}
				</select>
			</div>
			<div class="col-md-8">
				<div class="alert alert-info mb-0">
					<strong>Legenda:</strong> Každá barva pøedstavuje jiného technika. Kliknutím na událost zobrazíte detail.
				</div>
			</div>
		</div>
	</div>
</div>

<div class="card">
	<div class="card-body">
		<div id="calendar"></div>
	</div>
</div>

<div class="modal fade" id="eventModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Detail zakázky</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" id="eventModalBody">
				<!--obsah se doplni js-->
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zavøít</button>
				<a id="viewOrderBtn" href="#" class="btn btn-primary">Zobrazit zakázku</a>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<!-- FullCalendar CSS & JS -->
	<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			var calendarEl = document.getElementById('calendar');
			var technicianFilter = document.getElementById('technicianFilter');
			var eventModal = new bootstrap.Modal(document.getElementById('eventModal'));

			var calendar = new FullCalendar.Calendar(calendarEl, {
				initialView: 'dayGridMonth',
				locale: 'cs',
				headerToolbar: {
					left: 'prev,next today',
					center: 'title',
					right: 'dayGridMonth,timeGridWeek,timeGridDay'
				},
				buttonText: {
					today: 'Dnes',
					month: 'Mìsíc',
					week: 'Týden',
					day: 'Den'
				},
				slotMinTime: '07:00:00',
				slotMaxTime: '19:00:00',
				height: 'auto',
				events: function(info, successCallback, failureCallback) {
					var technicianId = technicianFilter.value;
					var url = '/Calendar/GetEvents?technicianId=' + technicianId +
							'&start=' + info.startStr +
							'&end=' + info.endStr;

					fetch(url)
						.then(response => response.json())
						.then(data => successCallback(data))
						.catch(error => {
							console.error('Error fetching events:', error);
							failureCallback(error);
						});
				},
				eventClick: function(info) {
					var event = info.event;
					var props = event.extendedProps;

					var modalBody = document.getElementById('eventModalBody');
					modalBody.innerHTML = `
						<dl class="row">
							<dt class="col-sm-4">Nemovitost:</dt>
							<dd class="col-sm-8"><strong>${props.propertyTitle || 'N/A'}</strong><br/>
								<small class="text-muted">${props.propertyAddress || ''}</small>
							</dd>

							<dt class="col-sm-4">Technik:</dt>
							<dd class="col-sm-8">${props.technicianName || 'Nepøiøazeno'}</dd>

							<dt class="col-sm-4">Status:</dt>
							<dd class="col-sm-8">
								<span class="badge ${getStatusBadgeClass(props.status)}">${formatStatus(props.status)}</span>
							</dd>

							<dt class="col-sm-4">Od:</dt>
							<dd class="col-sm-8">${formatDate(event.start)}</dd>

							<dt class="col-sm-4">Do:</dt>
							<dd class="col-sm-8">${formatDate(event.end)}</dd>

							<dt class="col-sm-4">Popis:</dt>
							<dd class="col-sm-8">${info.event.extendedProps.description || 'Bez popisu'}</dd>
						</dl>
					`;

					document.getElementById('viewOrderBtn').href = '/Orders/Details/' + props.orderId;
					eventModal.show();
				},
				eventDidMount: function(info) {
					info.el.title = info.event.extendedProps.description || '';
				}
			});

			calendar.render();

			technicianFilter.addEventListener('change', function() {
				calendar.refetchEvents();
			});

			function formatDate(date) {
				if (!date) return 'N/A';
				return new Date(date).toLocaleString('cs-CZ', {
					day: '2-digit',
					month: '2-digit',
					year: 'numeric',
					hour: '2-digit',
					minute: '2-digit'
				});
			}

			function getStatusBadgeClass(status) {
				switch(status) {
					case 'New': return 'bg-info';
					case 'InProgress': return 'bg-warning text-dark';
					case 'Done': return 'bg-success';
					default: return 'bg-secondary';
				}
			}

			function formatStatus(status) {
				switch(status) {
					case 'New': return 'Nová';
					case 'InProgress': return 'Probíhá';
					case 'Done': return 'Dokonèena';
					default: return status;
				}
			}
		});
	</script>
}
