@model Order
@{
	ViewData["Title"] = "Vytvoøit zakázku";
	var properties = ViewBag.Properties as IEnumerable<Property> ?? Enumerable.Empty<Property>();
	var technicians = ViewBag.Technicians as IEnumerable<User> ?? Enumerable.Empty<User>();
}

<h1>Vytvoøit novou zakázku</h1>

<div class="row">
	<div class="col-md-8">
		<form method="post">
			<div class="card mb-3">
				<div class="card-header">
					<h5 class="mb-0">Základní informace</h5>
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label class="form-label" asp-for="PropertyId">Nemovitost *</label>
						<select class="form-select" asp-for="PropertyId" required>
							<option value="">-- Vyberte nemovitost --</option>
							@foreach (var prop in properties)
							{
								<option value="@prop.Id">
									@prop.Title - @prop.Address
									@if (prop.Owner != null)
									{
										<text>(Vlastník: @prop.Owner.Name)</text>
									}
								</option>
							}
						</select>
						<span asp-validation-for="PropertyId" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label class="form-label" asp-for="Description">Popis *</label>
						<textarea class="form-control" asp-for="Description" rows="4" required
								  placeholder="Popište závadu nebo požadovanou opravu..."></textarea>
						<span asp-validation-for="Description" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label class="form-label" asp-for="Status">Status</label>
						<select class="form-select" asp-for="Status" asp-items="Html.GetEnumSelectList<OrderStatus>()"></select>
						<span asp-validation-for="Status" class="text-danger"></span>
					</div>
				</div>
			</div>

			<div class="card mb-3">
				<div class="card-header">
					<h5 class="mb-0">Pøiøazení a plánování</h5>
				</div>
				<div class="card-body">
					<div class="mb-3">
						<label class="form-label" asp-for="AssignedTechnicianId">Pøiøazený technik</label>
						<select class="form-select" asp-for="AssignedTechnicianId">
							<option value="">-- Nepøiøazeno --</option>
							@foreach (var tech in technicians)
							{
								<option value="@tech.Id">@tech.Name (@tech.Email)</option>
							}
						</select>
						<span asp-validation-for="AssignedTechnicianId" class="text-danger"></span>
						<small class="text-muted">Mùžete pøiøadit pozdìji</small>
					</div>

					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label" asp-for="ScheduledFromUtc">Plánováno od</label>
							<input class="form-control" asp-for="ScheduledFromUtc" type="datetime-local" />
							<span asp-validation-for="ScheduledFromUtc" class="text-danger"></span>
						</div>
						<div class="col-md-6 mb-3">
							<label class="form-label" asp-for="ScheduledToUtc">Plánováno do</label>
							<input class="form-control" asp-for="ScheduledToUtc" type="datetime-local" />
							<span asp-validation-for="ScheduledToUtc" class="text-danger"></span>
						</div>
					</div>
				</div>
			</div>

			<div class="mt-4">
				<button type="submit" class="btn btn-primary">Vytvoøit zakázku</button>
				<a asp-controller="Orders" asp-action="Index" class="btn btn-secondary">Zpìt na zakázky</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
