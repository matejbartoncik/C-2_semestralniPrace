@{
	ViewData["Title"] = "Exportovat zakázky";
}

<div class="row justify-content-center">
	<div class="col-md-6">
		<h1 class="mb-4">Exportovat zakázky</h1>

		<div class="card">
			<div class="card-body text-center">
				<p class="lead">Exportujte všechny zakázky do CSV souboru</p>

				<div class="my-4">

					<h3 class="mt-3">CSV formát</h3>
					<p class="text-muted">Kompatibilní s Excel, Google Sheets, LibreOffice</p>
					<p class="text-muted"><small>Oddìlovaè: støedník (;)</small></p>
				</div>

				<a asp-controller="Orders" asp-action="Export" class="btn btn-primary btn-lg">
					Stáhnout CSV
				</a>

				<div class="alert alert-info mt-4 text-start">
					<strong>Co obsahuje export:</strong>
					<ul class="mb-0">
						<li>Všechny zakázky s detaily</li>
						<li>Informace o nemovitostech</li>
						<li>Pøiøazení technici</li>
						<li>Naplánované termíny</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="mt-3">
			<a asp-controller="Orders" asp-action="Index" class="btn btn-secondary">Zpìt na zakázky</a>
		</div>
	</div>
</div>
