@model IEnumerable<Order>
@{
    ViewData["Title"] = "Orders";
    var props = ViewBag.Properties as IEnumerable<Property> ?? Enumerable.Empty<Property>();
    var techs = ViewBag.Technicians as IEnumerable<User> ?? Enumerable.Empty<User>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Orders</h1>
    <a class="btn btn-primary" href="/Orders/Create">Create New Order</a>
</div>

<form method="get" class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Filters</h5>
        <div class="row g-3">
     <div class="col-md-3">
   <label class="form-label">Status</label>
   <select class="form-select" name="status">
        <option value="">-- All Statuses --</option>
    @foreach (var s in Enum.GetValues<OrderStatus>())
        {
        <option value="@s">@s</option>
               }
  </select>
 </div>
            <div class="col-md-4">
    <label class="form-label">Property</label>
        <select class="form-select" name="propertyId">
        <option value="">-- All Properties --</option>
     @foreach (var p in props)
         {
       <option value="@p.Id">@p.Title (@p.Address)</option>
      }
      </select>
            </div>
            <div class="col-md-3">
    <label class="form-label">Technician</label>
   <select class="form-select" name="technicianId">
        <option value="">-- All Technicians --</option>
       @foreach (var t in techs)
   {
          <option value="@t.Id">@t.Name</option>
             }
    </select>
            </div>
      <div class="col-md-2 d-flex align-items-end">
   <button type="submit" class="btn btn-secondary w-100">Apply Filters</button>
            </div>
      </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <strong>No orders found.</strong> Click "Create New Order" to add your first order.
  </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
     <tr>
    <th>Created</th>
          <th>Property</th>
    <th>Description</th>
            <th>Status</th>
           <th>Technician</th>
          <th>ScUtchedule</th>
           <th class="text-end">Actions</th>
         </tr>
</thead>
            <tbody>
      @foreach (var o in Model)
          {
           <tr>
          <td>
          <small>@o.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
          </td>
           <td>
           @if (o.Property != null)
   {
              <strong>@o.Property.Title</strong><br />
<small class="text-muted">@o.Property.Address</small>
   @if (o.Property.Owner != null)
     {
     <br /><small class="text-muted">Owner: @o.Property.Owner.Name</small>
              }
        }
         else
      {
           <span class="text-muted">N/A</span>
       }
               </td>
         <td>@o.Description</td>
       <td>
             @if (o.Status == OrderStatus.New)
       {
      <span class="badge bg-info">@o.Status</span>
             }
  else if (o.Status == OrderStatus.InProgress)
             {
 <span class="badge bg-warning text-dark">@o.Status</span>
      }
      else
    {
    <span class="badge bg-success">@o.Status</span>
   }
       </td>
        <td>
     @if (o.AssignedTechnician != null)
     {
       @o.AssignedTechnician.Name
                }
      else
          {
                 <span class="text-muted">Unassigned</span>
             }
        </td>
         <td>
    @if (o.ScheduledFromUtc != null && o.ScheduledToUtc != null)
          {
              <small>
      @o.ScheduledFromUtc.Value.ToLocalTime().ToString("dd.MM. HH:mm")<br />
- @o.ScheduledToUtc.Value.ToLocalTime().ToString("dd.MM. HH:mm")
     </small>
     }
else
      {
     <span class="text-muted">Not scheduled</span>
          }
              </td>
              <td class="text-end">
 <div class="btn-group" role="group">
 <a class="btn btn-sm btn-outline-primary" href="/Orders/Details/@o.Id" title="View Details">Details</a>
   <a class="btn btn-sm btn-outline-secondary" href="/Orders/Edit/@o.Id" title="Edit">Edit</a>
   <a class="btn btn-sm btn-outline-danger" href="/Orders/Delete/@o.Id" title="Delete">Delete</a>
          </div>
             </td>
           </tr>
         }
        </tbody>
        </table>
    </div>

    <div class="mt-3">
        <p class="text-muted">Total: @Model.Count() orders</p>
    </div>
}
