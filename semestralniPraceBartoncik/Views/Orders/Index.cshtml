@model IEnumerable<Order>
@{
	ViewData["Title"] = "Zakázky";
	var props = ViewBag.Properties as IEnumerable<Property> ?? Enumerable.Empty<Property>();
	var techs = ViewBag.Technicians as IEnumerable<User> ?? Enumerable.Empty<User>();
	var currentSearch = ViewBag.CurrentSearch as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1>Zakázky</h1>
	<div>
		<a class="btn btn-success me-2" href="/Orders/Export">
			Exportovat
		</a>
		<a class="btn btn-info me-2" href="/Orders/Import">
			Importovat
		</a>
		<a class="btn btn-primary" href="/Orders/Create">Vytvoøit novou zakázku</a>
	</div>
</div>

<form method="get" class="card mb-4">
	<div class="card-body">
		<h5 class="card-title">Filtry a vyhledávání</h5>
		<div class="row g-3 mb-3">
			<div class="col-md-12">
				<label class="form-label">Vyhledávání</label>
				<input type="text" class="form-control" name="search"
					   placeholder="Hledat v popisu, názvu nemovitosti nebo adrese..."
					   value="@currentSearch" />
			</div>
		</div>
		<div class="row g-3">
			<div class="col-md-3">
				<label class="form-label">Status</label>
				<select class="form-select" name="status">
					<option value="">-- Všechny statusy --</option>
					@foreach (var s in Enum.GetValues<OrderStatus>())
					{
						<option value="@s">@s</option>
					}
				</select>
			</div>
			<div class="col-md-4">
				<label class="form-label">Nemovitost</label>
				<select class="form-select" name="propertyId">
					<option value="">-- Všechny nemovitosti --</option>
					@foreach (var p in props)
					{
						<option value="@p.Id">@p.Title (@p.Address)</option>
					}
				</select>
			</div>
			<div class="col-md-3">
				<label class="form-label">Technik</label>
				<select class="form-select" name="technicianId">
					<option value="">-- Všichni technici --</option>
					@foreach (var t in techs)
					{
						<option value="@t.Id">@t.Name</option>
					}
				</select>
			</div>
			<div class="col-md-2 d-flex align-items-end">
				<button type="submit" class="btn btn-secondary w-100">Aplikovat filtry</button>
			</div>
		</div>
	</div>
</form>

@if (!Model.Any())
{
	<div class="alert alert-info">
		<strong>Žádné zakázky nalezeny.</strong>
		@if (!string.IsNullOrWhiteSpace(currentSearch))
		{
			<text>Zkuste jiné vyhledávací kritérium nebo </text>
			<a href="/Orders">zobrazit všechny zakázky</a>

			<text>.</text>
		}
		else
		{
			<text>Kliknutím na "Vytvoøit novou zakázku" pøidejte první zakázku.</text>
		}
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>Vytvoøeno</th>
					<th>Nemovitost</th>
					<th>Popis</th>
					<th>Status</th>
					<th>Technik</th>
					<th>Plán</th>
					<th class="text-end">Akce</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var o in Model)
				{
					<tr>
						<td>
							<small>@o.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
						</td>
						<td>
							@if (o.Property != null)
							{
								<strong>@o.Property.Title</strong>
					
								<br />
								<small class="text-muted">@o.Property.Address</small>
								@if (o.Property.Owner != null)
								{
									<br />
					
									<small class="text-muted">Vlastník: @o.Property.Owner.Name</small>
								}
							}
							else
							{
								<span class="text-muted">N/A</span>
							}
						</td>
						<td>@o.Description</td>
						<td>
							@if (o.Status == OrderStatus.New)
							{
								<span class="badge bg-info">Nová</span>
							}
							else if (o.Status == OrderStatus.InProgress)
							{
								<span class="badge bg-warning text-dark">Probíhá</span>
							}
							else
							{
								<span class="badge bg-success">Dokonèena</span>
							}
						</td>
						<td>
							@if (o.AssignedTechnician != null)
							{
								@o.AssignedTechnician.Name
							}
							else
							{
								<span class="text-muted">Nepøiøazeno</span>
							}
						</td>
						<td>
							@if (o.ScheduledFromUtc != null && o.ScheduledToUtc != null)
							{
								<small>
									@o.ScheduledFromUtc.Value.ToLocalTime().ToString("dd.MM. HH:mm")<br />
									- @o.ScheduledToUtc.Value.ToLocalTime().ToString("dd.MM. HH:mm")
								</small>
							}
							else
							{
								<span class="text-muted">Neplánováno</span>
							}
						</td>
						<td class="text-end">
							<div class="btn-group" role="group">
								<a class="btn btn-sm btn-outline-primary" href="/Orders/Details/@o.Id" title="Zobrazit detail">Detail</a>
								<a class="btn btn-sm btn-outline-secondary" href="/Orders/Edit/@o.Id" title="Upravit">Upravit</a>
								<a class="btn btn-sm btn-outline-danger" href="/Orders/Delete/@o.Id" title="Smazat">Smazat</a>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div class="mt-3 d-flex justify-content-between align-items-center">
		<p class="text-muted mb-0">Celkem: @Model.Count() zakázek</p>
		@if (!string.IsNullOrWhiteSpace(currentSearch))
		{
			<a href="/Orders" class="btn btn-sm btn-outline-secondary">Zrušit vyhledávání</a>
		}
	</div>
}
