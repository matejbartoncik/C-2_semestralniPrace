@model Property
@{
	ViewData["Title"] = "Detail nemovitosti";
}

<div class="mb-4">
	<h1>Detail nemovitosti</h1>
</div>

<div class="card">
	<div class="card-body">
		<dl class="row">
			<dt class="col-sm-3">Název</dt>
			<dd class="col-sm-9">@Model.Title</dd>

			<dt class="col-sm-3">Adresa</dt>
			<dd class="col-sm-9">@Model.Address</dd>

			<dt class="col-sm-3">Vlastník</dt>
			<dd class="col-sm-9">
				@if (Model.Owner != null)
				{
					<div>
						<strong>@Model.Owner.Name</strong><br />
						<small class="text-muted">@Model.Owner.Email</small><br />
						<span class="badge bg-info">
							@if (Model.Owner.Role == UserRole.Owner)
							{
								<text>Vlastník</text>
							}
							else if (Model.Owner.Role == UserRole.Admin)
							{
								<text>Administrator</text>
							}
							else
							{
								<text>@Model.Owner.Role</text>
							}
						</span>
					</div>
				}
				else
				{
					<span class="text-muted">Žádný vlastník</span>
				}
			</dd>

			<dt class="col-sm-3">ID nemovitosti</dt>
			<dd class="col-sm-9"><code>@Model.Id</code></dd>
		</dl>
	</div>
</div>

<div class="mt-3">
	<a class="btn btn-secondary" href="/Properties/Edit/@Model.Id">Upravit</a>
	<a class="btn btn-outline-danger" href="/Properties/Delete/@Model.Id">Smazat</a>
	<a class="btn btn-outline-secondary" href="/Properties">Zpìt na seznam</a>
</div>
