@model Property
@{
	ViewData["Title"] = "Upravit nemovitost";
	var owners = ViewBag.Owners as IEnumerable<User> ?? Enumerable.Empty<User>();
}

<h1>Upravit nemovitost</h1>

<div class="row">
	<div class="col-md-6">
		<form method="post">
			<input type="hidden" asp-for="Id" />

			<div class="mb-3">
				<label class="form-label" asp-for="Title">Název</label>
				<input class="form-control" asp-for="Title" required />
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label class="form-label" asp-for="Address">Adresa</label>
				<input class="form-control" asp-for="Address" required />
				<span asp-validation-for="Address" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label class="form-label" asp-for="OwnerId">Vlastník</label>
				<select class="form-select" asp-for="OwnerId" required>
					<option value="">-- Vyberte vlastníka --</option>
					@foreach (var owner in owners)
					{
						<option value="@owner.Id">@owner.Name (@owner.Email)</option>
					}
				</select>
				<span asp-validation-for="OwnerId" class="text-danger"></span>
			</div>

			<div class="mt-4">
				<button type="submit" class="btn btn-primary">Uložit zmìny</button>
				<div class="mt-3">
					<a asp-controller="Properties" asp-action="Index" class="btn btn-secondary">Zpìt</a>
				</div>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
