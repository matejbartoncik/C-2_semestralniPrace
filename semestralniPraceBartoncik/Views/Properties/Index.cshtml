@model IEnumerable<Property>
@{
	ViewData["Title"] = "Nemovitosti";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1>Nemovitosti</h1>
	<div>
		<a class="btn btn-success me-2" href="/Properties/Export">
			Exportovat
		</a>
		<a class="btn btn-info me-2" href="/Properties/Import">
			Importovat
		</a>
		<a class="btn btn-primary" href="/Properties/Create">
			Vytvořit novou nemovitost
		</a>
	</div>
</div>

@if (!Model.Any())
{
	<div class="alert alert-info">
		<strong>Žádné nemovitosti nalezeny.</strong> Kliknutím na "Vytvořit novou nemovitost" přidejte první nemovitost.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>Název</th>
					<th>Adresa</th>
					<th>Vlastník</th>
					<th class="text-end">Akce</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var property in Model)
				{
					<tr>
						<td>
							<strong>@property.Title</strong>
						</td>
						<td>@property.Address</td>
						<td>
							@if (property.Owner != null)
							{
								<span>@property.Owner.Name</span>
								<br />
								<small class="text-muted">@property.Owner.Email</small>
							}
							else
							{
								<span class="text-muted">Žádný vlastník</span>
							}
						</td>
						<td class="text-end">
							<div class="btn-group" role="group">
								<a class="btn btn-sm btn-outline-primary" href="/Properties/Details/@property.Id" title="Zobrazit detail">
									Detail
								</a>
								<a class="btn btn-sm btn-outline-secondary" href="/Properties/Edit/@property.Id" title="Upravit">
									Upravit
								</a>
								<a class="btn btn-sm btn-outline-danger" href="/Properties/Delete/@property.Id" title="Smazat">
									Smazat
								</a>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div class="mt-3">
		<p class="text-muted">Celkem: @Model.Count() nemovitostí</p>
	</div>
}