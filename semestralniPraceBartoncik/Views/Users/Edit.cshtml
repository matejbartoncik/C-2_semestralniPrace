@model User
@{
	ViewData["Title"] = "Upravit uživatele";
}

<h1>Upravit uživatele</h1>

<div class="row">
	<div class="col-md-6">
		<form method="post">
			<input type="hidden" asp-for="Id" />

			<div class="mb-3">
				<label class="form-label" asp-for="Name">Jméno *</label>
				<input class="form-control" asp-for="Name" required />
				<span asp-validation-for="Name" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label class="form-label" asp-for="Email">Email *</label>
				<input class="form-control" asp-for="Email" type="email" required />
				<span asp-validation-for="Email" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label class="form-label" asp-for="Role">Role *</label>
				<select class="form-select" asp-for="Role" required>
					<option value="Admin">Administrator - plný přístup</option>
					<option value="Technician">Technik - provádí opravy</option>
					<option value="Owner">Vlastník - vlastník nemovitosti</option>
				</select>
				<span asp-validation-for="Role" class="text-danger"></span>
			</div>

			<div class="mt-4">
				<button type="submit" class="btn btn-primary">Uložit změny</button>
				<a asp-controller="Users" asp-action="Index" class="btn btn-secondary">Zpět na uživatele</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}