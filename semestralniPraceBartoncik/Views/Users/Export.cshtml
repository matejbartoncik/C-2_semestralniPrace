@{
	ViewData["Title"] = "Exportovat uživatele";
}

<div class="row justify-content-center">
	<div class="col-md-6">
		<h1 class="mb-4">Exportovat uživatele</h1>

		<div class="card">
			<div class="card-body text-center">
				<p class="lead">Exportujte všechny uživatele do CSV souboru</p>

				<div class="my-4">
					<h3 class="mt-3">CSV formát</h3>
					<p class="text-muted">Kompatibilní s Excel, Google Sheets, LibreOffice</p>
					<p class="text-muted"><small>Oddìlovaè: støedník (;)</small></p>
				</div>

				<form method="post" asp-action="ExportCsv">
					<button type="submit" class="btn btn-primary btn-lg">
						Stáhnout CSV
					</button>
				</form>

				<div class="alert alert-info mt-4 text-start">
					<strong>Co obsahuje export:</strong>
					<ul class="mb-0">
						<li>Všichni uživatelé</li>
						<li>Jména a emaily</li>
						<li>Role (Admin, Technik, Vlastník)</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="mt-3">
			<a asp-controller="Users" asp-action="Index" class="btn btn-secondary">Zpìt na uživatele</a>
		</div>
	</div>
</div>
