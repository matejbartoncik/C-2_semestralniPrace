@model IEnumerable<User>
@{
	ViewData["Title"] = "Uživatelé";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1>Uživatelé</h1>
	<div>
		<a class="btn btn-success me-2" href="/Users/Export">
			Exportovat
		</a>
		<a class="btn btn-info me-2" href="/Users/Import">
			Importovat
		</a>
		<a class="btn btn-primary" href="/Users/Create">Vytvořit nového uživatele</a>
	</div>
</div>

@if (!Model.Any())
{
	<div class="alert alert-info">
		<strong>Žádní uživatelé nalezeni.</strong> Kliknutím na "Vytvořit nového uživatele" přidejte prvního uživatele.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>Jméno</th>
					<th>Email</th>
					<th>Role</th>
					<th class="text-end">Akce</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var u in Model)
				{
					<tr>
						<td><strong>@u.Name</strong></td>
						<td>@u.Email</td>
						<td>
							@if (u.Role == UserRole.Admin)
							{
								<span class="badge bg-danger">Administrator</span>
							}
							else if (u.Role == UserRole.Technician)
							{
								<span class="badge bg-primary">Technik</span>
							}
							else
							{
								<span class="badge bg-secondary">Vlastník</span>
							}
						</td>
						<td class="text-end">
							<div class="btn-group" role="group">
								<a class="btn btn-sm btn-outline-secondary" href="/Users/Edit/@u.Id" title="Upravit">Upravit</a>
								<a class="btn btn-sm btn-outline-danger" href="/Users/Delete/@u.Id" title="Smazat">Smazat</a>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>

	<div class="mt-3">
		<p class="text-muted">Celkem: @Model.Count() uživatelů</p>
	</div>
}